{
  "name": "@feelgood/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "start:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/kill-metro-ports.ps1 && expo start -c",
    "start:phone": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-phone.ps1",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "tsc --noEmit",
    "build:preview": "npx eas-cli build --profile preview --platform all",
    "build:production": "npx eas-cli build --profile production --platform all",
    "submit:ios": "npx eas-cli submit --platform ios --profile production --latest",
    "submit:android": "npx eas-cli submit --platform android --profile production --latest"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@expo-google-fonts/league-spartan": "^0.4.2",
    "@expo-google-fonts/open-sans": "^0.4.2",
    "@expo-google-fonts/raleway": "^0.4.2",
    "@feelgood/shared": "file:../../packages/shared",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.2",
    "@tanstack/react-query": "^5.101.1",
    "base64-arraybuffer": "^1.0.2",
    "expo": "^58.0.0",
    "expo-apple-authentication": "~58.0.3",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-auth-session": "~58.0.19",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.1.0",
    "lucide-react-native": "^0.575.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "react-dom": "19.3.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@feelgood/shared",
          "base64-arraybuffer"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
