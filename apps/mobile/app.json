{
  "expo": {
    "name": "The Feel Good Challenge",
    "slug": "feel-good-challenge",
    "scheme": "feelgood",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EBE5DD"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.feelgoodsociety.challenge",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Take a profile photo or weekly progress and vision board photos.",
        "NSPhotoLibraryUsageDescription": "Choose photos for your profile, vision board, and weekly progress.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EBE5DD"
      },
      "package": "com.feelgoodsociety.challenge",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos for your profile, vision board, and weekly progress.",
          "cameraPermission": "Take a profile photo or weekly progress and vision board photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#222222"
        }
      ],
      "expo-apple-authentication",
      "expo-font",
      "expo-web-browser",
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "legalPrivacyUrl": "https://bruvmdcstlkszvjruska.supabase.co/storage/v1/object/public/legal/privacy.html",
      "legalTermsUrl": "https://bruvmdcstlkszvjruska.supabase.co/storage/v1/object/public/legal/terms.html",
      "legalSupportUrl": "https://bruvmdcstlkszvjruska.supabase.co/storage/v1/object/public/legal/support.html",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "21d53822-332d-4e0b-9044-7b937398ba8a"
      }
    },
    "owner": "galaxy15478"
  }
}
