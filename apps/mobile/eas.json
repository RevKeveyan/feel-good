{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "ios": {
        "image": "latest"
      },
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
        "EXPO_PUBLIC_SUPABASE_URL": "https://bruvmdcstlkszvjruska.supabase.co",
        "EXPO_PUBLIC_MINDSET_AUDIO_BASE_URL": "https://bruvmdcstlkszvjruska.supabase.co/storage/v1/object/public/mindset-audio"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "management@networkco.net",
        "ascAppId": "6800691043",
        "appleTeamId": "69NTK354Z8"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
